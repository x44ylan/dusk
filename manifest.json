{
  "manifest_version": 3,
  "name": "Dusk",
  "description": "Dusk browser extension.",
  "version": "0.3.0",
  "action": {
    "default_icon": {
      "16": "src/assets/dusk-off-16.png",
      "32": "src/assets/dusk-off-32.png",
      "48": "src/assets/dusk-off-48.png",
      "128": "src/assets/dusk-off-128.png"
    },
    "default_title": "Dusk"
  },
  "icons": {
    "16": "src/assets/dusk-off-16.png",
    "32": "src/assets/dusk-off-32.png",
    "48": "src/assets/dusk-off-48.png",
    "128": "src/assets/dusk-off-128.png"
  },
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "permissions": [
    "contextMenus",
    "proxy",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "minimum_chrome_version": "108"
}
