{
  "manifest_version": 3,
  "name": "Dusk",
  "description": "Burp proxy toggle.",
  "version": "0.1.0",
  "action": {
    "default_icon": {
      "16": "src/assets/dusk-off-16.png",
      "32": "src/assets/dusk-off-32.png",
      "48": "src/assets/dusk-off-48.png",
      "128": "src/assets/dusk-off-128.png"
    },
    "default_title": "Dusk"
  },
  "icons": {
    "16": "src/assets/dusk-off-16.png",
    "32": "src/assets/dusk-off-32.png",
    "48": "src/assets/dusk-off-48.png",
    "128": "src/assets/dusk-off-128.png"
  },
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "permissions": [
    "proxy",
    "storage"
  ],
  "minimum_chrome_version": "108"
}
